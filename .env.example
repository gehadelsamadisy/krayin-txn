# Krayin settings. A value with spaces must be in quotes: NAME="Two Words"
APP_NAME='Krayin CRM'
APP_ENV=production
# Generate a new one on the server; never reuse the old key or the stock image's key.
APP_KEY=CHANGE_ME
APP_DEBUG=false
# Until a domain + HTTPS proxy exist: http://localhost:8080 (through an SSH tunnel)
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_CURRENCY=USD

VITE_HOST=
VITE_PORT=

# daily = one file per day in data/logs/krayin, kept LOG_DAILY_DAYS days
LOG_CHANNEL=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning

# Database: the krayin-mysql container. Passwords: make up long random ones,
# without $ or quotes (e.g. openssl rand -hex 24). MySQL is created with them
# on the first start.
DB_CONNECTION=mysql
DB_HOST=krayin-mysql
DB_PORT=3306
DB_DATABASE=krayin
DB_USERNAME=krayin_app
DB_PASSWORD=CHANGE_ME
DB_PREFIX=
MYSQL_ROOT_PASSWORD=CHANGE_ME

# --- Docker setup (read by docker-compose.yml and the scripts) ---------------
# Who can open Krayin: 127.0.0.1 = only this machine (use an SSH tunnel);
# 0.0.0.0 = every computer that can reach this server (office network).
# With 0.0.0.0 set APP_URL to http://<server-ip>:<KRAYIN_HTTP_PORT>.
KRAYIN_BIND=127.0.0.1
KRAYIN_HTTP_PORT=8080
# MySQL always stays on 127.0.0.1 (this machine / SSH tunnel only).
MYSQL_HOST_PORT=3306
MYSQL_BUFFER_POOL=1G
# Exact MySQL version. Change it only with ./scripts/update-mysql.sh <8.4.x>.
MYSQL_VERSION=8.4.11
# true = also run Krayin's scheduler (inbound-emails:process every 5 min,
# campaign:process daily). Off until decided.
KRAYIN_SCHEDULER=false
BACKUP_KEEP_DAYS=14
# Off-site copy of data/backups (rclone remote:folder), e.g. azure:krayin-backups
# or nas:/backups/krayin. Empty = not set up. See scripts/offsite-backup.sh.
BACKUP_REMOTE=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# MAIL_MAILER: smtp = Brevo or another SMTP server (MAIL_HOST..MAIL_ENCRYPTION below);
# graph = Microsoft 365 / Exchange Online (GRAPH_* below; MAIL_FROM_ADDRESS must be the
# mailbox the Entra app may send as). Setup steps: config/graph_mail.php.
MAIL_MAILER=smtp
GRAPH_TENANT_ID=CHANGE_ME
GRAPH_CLIENT_ID=CHANGE_ME
GRAPH_CLIENT_SECRET=CHANGE_ME
MAIL_ALLOWED_RECIPIENTS=CHANGE_ME
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=CHANGE_ME
MAIL_FROM_NAME="TXN Home Services"
MAIL_DOMAIN=CHANGE_ME

MAIL_RECEIVER_DRIVER=sendgrid

IMAP_HOST=CHANGE_ME
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=CHANGE_ME
IMAP_PASSWORD=CHANGE_ME

# Unused (empty in the current setup)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
CALCOM_API_KEY=CHANGE_ME

CALCOM_ALLOW_CUSTOMER_EMAIL=true
CALCOM_TEST_PERSON_ID=CHANGE_ME
CALCOM_TEST_RECIPIENT_EMAIL=CHANGE_ME
CALCOM_SINGLE_TEST_ATTEMPT=false
CALCOM_DEFAULT_TIMEZONE=America/Chicago
GEOCODIO_API_KEY=CHANGE_ME

# Twilio SMS (same account as TXNHome). Sending is limited to SMS_ALLOWED_RECIPIENTS.
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_MESSAGING_SERVICE_SID=CHANGE_ME
TWILIO_FROM_NUMBER=
SMS_ALLOWED_RECIPIENTS=CHANGE_ME

# Sender identity in customer emails/texts (required: no defaults in the code)
TXN_REP_NAME=CHANGE_ME
TXN_REP_CELL=CHANGE_ME
TXN_OFFICE_PHONE=CHANGE_ME

# Optional TXN settings (defaults live in config/*.php; set only to change them)
# TXN_COMPANY_NAME=TXN Home Services
# TXN_EMAIL_ACCENT=
# SMS_SIGNATURE=
# OSRM_URL=https://router.project-osrm.org
# CALCOM_ACTIVITY_USER_ID=
# CALCOM_SYNC_LOOKBACK_DAYS=
# LEAD_IMPORT_SOURCE_ID=2
# LEAD_IMPORT_TYPE_ID=1
# LEAD_IMPORT_OWNER_ID=1
# LEAD_IMPORT_STORE_REAL_EMAILS=false
# LEAD_IMPORT_CHECK_SECONDS=200
# FOLLOW_UP_REMINDER_HOURS=
# FOLLOW_UP_FINAL_HOURS=
# FOLLOW_UP_LOST_HOURS=
# FOLLOW_UP_MIN_HOURS_BEFORE_SLOT=
